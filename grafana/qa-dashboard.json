{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "The Loki data source this project's GRAFANA_LOKI_URL secret pushes to. Pick it at import time — every panel below is wired to ${DS_LOKI}, not a hardcoded UID, so this one JSON file can be imported unmodified into any *-qa project's own Grafana instance.",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" }
  ],
  "id": null,
  "uid": "qa-automation-dashboard-cypress",
  "title": "QA Automation Dashboard",
  "description": "Emulates Cypress Cloud's run analytics: current-state snapshot of the latest run plus time-series trends, sourced from the qa-automation-dashboard Grafana Loki sink (job=\"qa-automation-dashboard\"). See grafana/README.md in this repo before importing.",
  "tags": ["qa", "cypress", "automation"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5m", "15m", "30m", "1h"],
    "time_options": ["7d", "30d", "90d", "1y"]
  },
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "label": "Loki data source",
        "refresh": 1
      },
      {
        "name": "project",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values({job=\"qa-automation-dashboard\"}, project)",
        "definition": "label_values({job=\"qa-automation-dashboard\"}, project)",
        "label": "Project",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values({job=\"qa-automation-dashboard\", project=~\"$project\"}, environment)",
        "definition": "label_values({job=\"qa-automation-dashboard\", project=~\"$project\"}, environment)",
        "label": "Environment",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "browser",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\"}, browser)",
        "definition": "label_values({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\"}, browser)",
        "label": "Browser",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Current State — latest run in the selected time range",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Passed (latest run)",
      "description": "last_over_time of the `passed` field — the most recent run's passed-test count within the selected time range.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap passed [$__range])",
          "queryType": "instant",
          "legendFormat": "Passed"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed (latest run)",
      "description": "Thresholds: green at 0, red above 0.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap failed [$__range])",
          "queryType": "instant",
          "legendFormat": "Failed"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Flaky (latest run)",
      "description": "Thresholds: green at 0, orange above 0.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap flaky [$__range])",
          "queryType": "instant",
          "legendFormat": "Flaky"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Skipped (latest run)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap skipped [$__range])",
          "queryType": "instant",
          "legendFormat": "Skipped"
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Pass Rate (latest run)",
      "description": "UNVERIFIED cross-series transform — sanity-check first. Computed client-side from the same run's Passed/Failed stats via calculateField transforms: Total = Passed + Failed, PassRate = Passed / Total (a 0-1 fraction; unit percentunit renders it as %). If the two queries' fields aren't named exactly 'Passed'/'Failed' in your Grafana version, this panel will show No data — fix by checking the actual field names in the panel editor and updating the transformations' left/right operands to match.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.9 }, { "color": "green", "value": 0.98 }]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap passed [$__range])",
          "queryType": "instant",
          "legendFormat": "Passed"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap failed [$__range])",
          "queryType": "instant",
          "legendFormat": "Failed"
        }
      ],
      "transformations": [
        { "id": "calculateField", "options": { "mode": "binary", "binary": { "left": "Passed", "operator": "+", "right": "Failed" }, "alias": "Total", "replaceFields": false } },
        { "id": "calculateField", "options": { "mode": "binary", "binary": { "left": "Passed", "operator": "/", "right": "Total" }, "alias": "PassRate", "replaceFields": false } },
        { "id": "organize", "options": { "includeByName": { "PassRate": true }, "excludeByName": { "Passed": true, "Failed": true, "Total": true }, "indexByName": {}, "renameByName": {} } }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Duration (latest run)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap elapsed_seconds [$__range])",
          "queryType": "instant",
          "legendFormat": "Duration"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Cost (latest run)",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 5 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "color": { "mode": "fixed", "fixedColor": "purple" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap cost_usd [$__range])",
          "queryType": "instant",
          "legendFormat": "Cost"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Recent Runs",
      "description": "Last 20 runs, newest first. Uses an 'Extract fields' transform (source: Line, format: JSON) to split the log line's JSON body into columns — this is the standard, version-portable way to get parsed Loki fields into a dashboard Table panel (Explore's own auto-column-expansion doesn't carry over to dashboards). UNVERIFIED against live data — sanity-check the column set once real runs exist.",
      "gridPos": { "h": 8, "w": 20, "x": 4, "y": 5 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Time", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json",
          "queryType": "range",
          "maxLines": 20,
          "direction": "backward"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "Line", "format": "json", "replace": false } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Line": true, "tsNs": true, "id": true, "labels": true, "job": true, "repo": true, "cloud_url": true, "specs_unrun": true },
            "indexByName": {
              "Time": 0, "status": 1, "project": 2, "environment": 3, "browser": 4,
              "passed": 5, "failed": 6, "flaky": 7, "skipped": 8,
              "elapsed_seconds": 9, "cost_usd": 10, "commit_sha": 11, "run_id": 12, "run_url": 13
            },
            "renameByName": { "elapsed_seconds": "duration (s)", "cost_usd": "cost (USD)" }
          }
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Trends — respects the time range picker above (try Last 7 days / Last 30 days / Last 90 days / Last 1 year)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Test Results Over Time",
      "description": "Sum of passed/failed/flaky/skipped per $__interval bucket — the Cypress-Cloud-style stacked test-results chart.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80, "lineWidth": 0 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Passed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "Flaky" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "Skipped" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "gray" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(sum_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap passed [$__interval]))",
          "queryType": "range",
          "legendFormat": "Passed"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(sum_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap failed [$__interval]))",
          "queryType": "range",
          "legendFormat": "Failed"
        },
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(sum_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap flaky [$__interval]))",
          "queryType": "range",
          "legendFormat": "Flaky"
        },
        {
          "refId": "D",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(sum_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap skipped [$__interval]))",
          "queryType": "range",
          "legendFormat": "Skipped"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Pass Rate Over Time",
      "description": "UNVERIFIED cross-series transform, same caveat as the Pass Rate gauge above — sanity-check field names once live. Joins the Passed/Failed series on Time, then PassRate = Passed / (Passed + Failed) per bucket.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(sum_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap passed [$__interval]))",
          "queryType": "range",
          "legendFormat": "Passed"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(sum_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap failed [$__interval]))",
          "queryType": "range",
          "legendFormat": "Failed"
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "Time", "mode": "outer" } },
        { "id": "calculateField", "options": { "mode": "binary", "binary": { "left": "Passed", "operator": "+", "right": "Failed" }, "alias": "Total", "replaceFields": false } },
        { "id": "calculateField", "options": { "mode": "binary", "binary": { "left": "Passed", "operator": "/", "right": "Total" }, "alias": "PassRate", "replaceFields": false } },
        { "id": "organize", "options": { "includeByName": { "Time": true, "PassRate": true }, "excludeByName": { "Passed": true, "Failed": true, "Total": true }, "indexByName": {}, "renameByName": {} } }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Run Duration Trend",
      "description": "Average elapsed_seconds per $__interval bucket.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "avg(avg_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", environment=~\"$environment\", browser=~\"$browser\", status=~\"PASSED|FAILED\"} | json | unwrap elapsed_seconds [$__interval]))",
          "queryType": "range",
          "legendFormat": "Avg run duration"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Spec Insights — requires spec_timings_json to be flowing (type=\"spec\" stream)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Slowest Specs (total duration in range)",
      "description": "topk(10) by total duration_seconds summed over the selected range, from the type=\"spec\" stream.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "topk(10, sum by (spec) (sum_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", type=\"spec\"} | json | unwrap duration_seconds [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{spec}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Spec Duration Trend",
      "description": "Average per-spec duration_seconds per $__interval bucket, across all specs, from the type=\"spec\" stream.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "avg(avg_over_time({job=\"qa-automation-dashboard\", project=~\"$project\", type=\"spec\"} | json | unwrap duration_seconds [$__interval]))",
          "queryType": "range",
          "legendFormat": "Avg spec duration"
        }
      ]
    }
  ]
}
